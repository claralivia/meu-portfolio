# Google Analytics 4 measurement ID (Admin > Data Streams > Web stream)
VITE_GA_ID=G-XXXXXXXXXX

# Canonical site URL, used for Open Graph tags
VITE_BASE_URL=https://claralivia.dev

# Web3Forms access key (web3forms.com > create a free access key)
# Powers the contact form in ContactSection — without it, submissions fail.
VITE_WEB3FORMS_ACCESS_KEY=
